(http_server 8088

  (defun next_note_id ()
    (do
      (store_open kv "file://data/notes.json")
      (let (seq_rec (store_get kv "_seq"))
        (if (is_nil seq_rec)
          (do
            (store_put kv "_seq" (dict ("val" 1)))
            (return "1")
          )
          (let (next (+ (map_get seq_rec "val") 1))
            (do
              (store_put kv "_seq" (dict ("val" next)))
              (return (to_string next))
            )
          )
        )
      )
    )
  )

  (route "/" (lambda (req)
    (do
      (res_header "Content-Type" "text/html; charset=utf-8")
      (res 200 "text/html" (read_file "static/index.html"))
    )
  ))

  (route "/index.html" (lambda (req)
    (do
      (res_header "Content-Type" "text/html; charset=utf-8")
      (res 200 "text/html" (read_file "static/index.html"))
    )
  ))

  (route "/app.css" (lambda (req)
    (do
      (res_header "Content-Type" "text/css; charset=utf-8")
      (res 200 "text/css" (read_file "static/app.css"))
    )
  ))

  (route "/app.js" (lambda (req)
    (do
      (res_header "Content-Type" "application/javascript; charset=utf-8")
      (res 200 "application/javascript" (read_file "static/app.js"))
    )
  ))

  (route "/api/health" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (res_json 200 (dict ("status" "ok") ("app" "howlnotes") ("persistence" "file://data/notes.json") ("version" "0.1.0")))
      )
    )
  ))

  (route "/api/notes" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (let (m (req_method req))
        (if (= m "OPTIONS")
          (res_json 200 (dict ("status" "ok")))
          (if (= m "GET")
            (do
              (store_open kv "file://data/notes.json")
              (let (notes (list))
                (let (all_ids_rec (store_get kv "_all_ids"))
                  (do
                    (if (is_nil all_ids_rec)
                      (do)
                      (let (ids (map_get all_ids_rec "ids"))
                        (for id ids
                          (let (note (store_get kv id))
                            (if (is_nil note)
                              (do)
                              (append notes note)
                            )
                          )
                        )
                      )
                    )
                    (res_json 200 (dict ("notes" notes)))
                  )
                )
              )
            )
            (if (= m "POST")
              (try_let (body (parse_json NoteInput req.body))
                (catch parse_err
                  (res_json 400 (dict ("error" "invalid_json")))
                )
                (let (content (map_get body "content"))
                  (if (or (is_nil content) (= content ""))
                    (res_json 400 (dict ("error" "content_required")))
                    (if (> (list_len (str_split content "")) 10000)
                      (res_json 400 (dict ("error" "content_too_long")))
                      (let (id (call next_note_id))
                        (let (now (to_string (time_now)))
                          (let (note (dict ("id" id) ("content" content) ("created_at" now) ("updated_at" now)))
                            (do
                              (store_open kv "file://data/notes.json")
                              (store_put kv id note)
                              (let (all_ids_rec (store_get kv "_all_ids"))
                                (let (ids (list))
                                  (do
                                    (if (is_nil all_ids_rec)
                                      (do)
                                      (set ids (map_get all_ids_rec "ids"))
                                    )
                                    (append ids id)
                                    (store_put kv "_all_ids" (dict ("ids" ids)))
                                    (res_json 201 note)
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
              (if (= m "PUT")
                (try_let (body (parse_json NoteInput req.body))
                  (catch parse_err
                    (res_json 400 (dict ("error" "invalid_json")))
                  )
                  (let (id (map_get body "id"))
                    (let (content (map_get body "content"))
                      (if (or (is_nil id) (= id ""))
                        (res_json 400 (dict ("error" "id_required")))
                        (if (or (is_nil content) (= content ""))
                          (res_json 400 (dict ("error" "content_required")))
                          (if (> (list_len (str_split content "")) 10000)
                            (res_json 400 (dict ("error" "content_too_long")))
                            (do
                              (store_open kv "file://data/notes.json")
                              (let (existing (store_get kv id))
                                (if (is_nil existing)
                                  (res_json 404 (dict ("error" "not_found")))
                                  (let (created_at (map_get existing "created_at"))
                                    (let (now (to_string (time_now)))
                                      (let (updated (dict ("id" id) ("content" content) ("created_at" created_at) ("updated_at" now)))
                                        (do
                                          (store_put kv id updated)
                                          (res_json 200 updated)
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
                (if (= m "DELETE")
                  (try_let (body (parse_json NoteInput req.body))
                    (catch parse_err
                      (res_json 400 (dict ("error" "invalid_json")))
                    )
                    (let (id (map_get body "id"))
                      (if (or (is_nil id) (= id ""))
                        (res_json 400 (dict ("error" "id_required")))
                        (do
                          (store_open kv "file://data/notes.json")
                          (let (existing (store_get kv id))
                            (if (is_nil existing)
                              (res_json 404 (dict ("error" "not_found")))
                              (do
                                (store_delete kv id)
                                (let (all_ids_rec (store_get kv "_all_ids"))
                                  (let (new_ids (list))
                                    (do
                                      (if (is_nil all_ids_rec)
                                        (do)
                                        (let (ids (map_get all_ids_rec "ids"))
                                          (for curr_id ids
                                            (if (!= curr_id id)
                                              (append new_ids curr_id)
                                              (do)
                                            )
                                          )
                                        )
                                      )
                                      (store_put kv "_all_ids" (dict ("ids" new_ids)))
                                      (res_json 200 (dict ("status" "ok") ("deleted" id)))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                  (res_json 405 (dict ("error" "method_not_allowed")))
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/notes/list" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (do
          (store_open kv "file://data/notes.json")
          (let (notes (list))
            (let (all_ids_rec (store_get kv "_all_ids"))
              (do
                (if (is_nil all_ids_rec)
                  (do)
                  (let (ids (map_get all_ids_rec "ids"))
                    (for id ids
                      (let (note (store_get kv id))
                        (if (is_nil note)
                          (do)
                          (append notes note)
                        )
                      )
                    )
                  )
                )
                (res_json 200 (dict ("notes" notes)))
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/notes/get" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json NoteInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (or (is_nil id) (= id ""))
              (res_json 400 (dict ("error" "id_required")))
              (do
                (store_open kv "file://data/notes.json")
                (let (note (store_get kv id))
                  (if (is_nil note)
                    (res_json 404 (dict ("error" "not_found")))
                    (res_json 200 note)
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/notes/create" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json NoteInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (content (map_get body "content"))
            (if (or (is_nil content) (= content ""))
              (res_json 400 (dict ("error" "content_required")))
              (if (> (list_len (str_split content "")) 10000)
                (res_json 400 (dict ("error" "content_too_long")))
                (let (id (call next_note_id))
                  (let (now (to_string (time_now)))
                    (let (note (dict ("id" id) ("content" content) ("created_at" now) ("updated_at" now)))
                      (do
                        (store_open kv "file://data/notes.json")
                        (store_put kv id note)
                        (let (all_ids_rec (store_get kv "_all_ids"))
                          (let (ids (list))
                            (do
                              (if (is_nil all_ids_rec)
                                (do)
                                (set ids (map_get all_ids_rec "ids"))
                              )
                              (append ids id)
                              (store_put kv "_all_ids" (dict ("ids" ids)))
                              (res_json 201 note)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/notes/update" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "POST, PUT, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json NoteInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (let (content (map_get body "content"))
              (if (or (is_nil id) (= id ""))
                (res_json 400 (dict ("error" "id_required")))
                (if (or (is_nil content) (= content ""))
                  (res_json 400 (dict ("error" "content_required")))
                  (if (> (list_len (str_split content "")) 10000)
                    (res_json 400 (dict ("error" "content_too_long")))
                    (do
                      (store_open kv "file://data/notes.json")
                      (let (existing (store_get kv id))
                        (if (is_nil existing)
                          (res_json 404 (dict ("error" "not_found")))
                          (let (created_at (map_get existing "created_at"))
                            (let (now (to_string (time_now)))
                              (let (updated (dict ("id" id) ("content" content) ("created_at" created_at) ("updated_at" now)))
                                (do
                                  (store_put kv id updated)
                                  (res_json 200 updated)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/notes/delete" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "POST, DELETE, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json NoteInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (or (is_nil id) (= id ""))
              (res_json 400 (dict ("error" "id_required")))
              (do
                (store_open kv "file://data/notes.json")
                (let (existing (store_get kv id))
                  (if (is_nil existing)
                    (res_json 404 (dict ("error" "not_found")))
                    (do
                      (store_delete kv id)
                      (let (all_ids_rec (store_get kv "_all_ids"))
                        (let (new_ids (list))
                          (do
                            (if (is_nil all_ids_rec)
                              (do)
                              (let (ids (map_get all_ids_rec "ids"))
                                (for curr_id ids
                                  (if (!= curr_id id)
                                    (append new_ids curr_id)
                                    (do)
                                  )
                                )
                              )
                            )
                            (store_put kv "_all_ids" (dict ("ids" new_ids)))
                            (res_json 200 (dict ("status" "ok") ("deleted" id)))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))
)
