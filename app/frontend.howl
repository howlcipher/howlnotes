(web_app

  (defun set_status (message is_error)
    (let (banner (dom_query "#status-banner"))
      (do
        (if (= message "")
          (do
            (set_text banner "")
            (set_attr banner "style" "display: none;")
          )
          (do
            (set_text banner message)
            (if (= is_error "true")
              (set_attr banner "class" "status-banner status-error")
              (set_attr banner "class" "status-banner status-success")
            )
            (set_attr banner "style" "display: block;")
          )
        )
      )
    )
  )

  (defun render_note (note)
    (type_hint note "dict")
    (let (id (attr_escape (to_string (map_get note "id"))))
      (let (content (to_string (map_get note "content")))
        (let (created_at (to_string (map_get note "created_at")))
          (let (updated_at (to_string (map_get note "updated_at")))
            (let (html "")
              (do
                (set html (str_join (list "<div class=\"note-card\" id=\"note-" id "\">") ""))
                (set html (str_join (list html "<div class=\"note-header\"><span class=\"note-badge\">Note #" id "</span><span class=\"note-timestamp\">" (html_escape created_at) "</span></div>") ""))
                (set html (str_join (list html "<div class=\"note-body\" id=\"note-content-" id "\">" (html_escape content) "</div>") ""))
                (set html (str_join (list html "<div class=\"note-actions\">") ""))
                (set html (str_join (list html "<button class=\"btn btn-secondary\" data-note-id=\"" id "\" onclick=\"start_edit(this.dataset.noteId)\">Edit</button>") ""))
                (set html (str_join (list html "<button class=\"btn btn-danger\" data-note-id=\"" id "\" onclick=\"delete_note(this.dataset.noteId)\">Delete</button>") ""))
                (set html (str_join (list html "</div></div>") ""))
                (return html)
              )
            )
          )
        )
      )
    )
  )

  (defun load_notes ()
    (do
      (call set_status "Loading notes..." "false")
      (try_let (resp (fetch "/api/notes" "GET"))
        (catch err
          (call set_status "Failed to connect to HowlNotes server" "true")
        )
        (try_let (json_resp (parse_json NoteList resp))
          (catch parse_err
            (call set_status "Received invalid response from server" "true")
          )
          (let (notes (map_get json_resp "notes"))
            (let (filter_text (dom_value (dom_query "#search-input")))
              (let (cards_html "")
                (let (count 0)
                  (do
                    (for note notes
                      (let (content (to_string (map_get note "content")))
                        (let (id (to_string (map_get note "id")))
                          (let (match true)
                            (do
                              (if (!= filter_text "")
                                (if (= (str_contains content filter_text) false)
                                  (set match false)
                                  (do)
                                )
                                (do)
                              )
                              (if match
                                (let (card (call render_note note))
                                  (do
                                    (set cards_html (str_join (list cards_html card) ""))
                                    (set count (+ count 1))
                                  )
                                )
                                (do)
                              )
                            )
                          )
                        )
                      )
                    )
                    (if (= count 0)
                      (set_html (dom_query "#notes-container") "<div class=\"empty-state\">No notes found. Create your first note above!</div>")
                      (set_html (dom_query "#notes-container") cards_html)
                    )
                    (call set_status "" "false")
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun create_note ()
    (let (input (dom_query "#new-note-content"))
      (let (content (dom_value input))
        (do
          (if (= content "")
            (call set_status "Note content cannot be empty" "true")
            (if (> (list_len (str_split content "")) 10000)
              (call set_status "Note content exceeds 10,000 characters limit" "true")
              (do
                (call set_status "Saving note..." "false")
                (let (req_body (encode_json (dict ("content" content))))
                  (try_let (resp (fetch "/api/notes" "POST" req_body))
                    (catch err
                      (call set_status "Failed to save note" "true")
                    )
                    (try_let (json_resp (parse_json NoteResponse resp))
                      (catch parse_err
                        (call set_status "Server error while saving note" "true")
                      )
                      (let (err_msg (map_get json_resp "error"))
                        (if (!= err_msg "")
                          (call set_status err_msg "true")
                          (do
                            (set input.value "")
                            (call set_status "Note created successfully!" "false")
                            (call load_notes)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun start_edit (id)
    (let (modal (dom_query "#edit-modal"))
      (let (id_input (dom_query "#edit-note-id"))
        (let (content_input (dom_query "#edit-note-content"))
          (do
            (set_attr id_input "value" id)
            (let (content_node (call document.getElementById (str_join (list "note-content-" id) "")))
              (set content_input.value content_node.textContent)
            )
            (set_attr modal "style" "display: flex;")
            (call content_input.focus)
          )
        )
      )
    )
  )

  (defun cancel_edit ()
    (let (modal (dom_query "#edit-modal"))
      (do
        (set_attr modal "style" "display: none;")
        (let (input (dom_query "#new-note-content")) (call input.focus))
        (call set_status "" "false")
      )
    )
  )

  (defun save_edit ()
    (let (id (dom_value (dom_query "#edit-note-id")))
      (let (content (dom_value (dom_query "#edit-note-content")))
        (do
          (if (= content "")
            (call set_status "Note content cannot be empty" "true")
            (if (> (list_len (str_split content "")) 10000)
              (call set_status "Note content exceeds 10,000 characters limit" "true")
              (do
                (call set_status "Updating note..." "false")
                (let (req_body (encode_json (dict ("id" id) ("content" content))))
                  (try_let (resp (fetch "/api/notes" "PUT" req_body))
                    (catch err
                      (call set_status "Failed to update note" "true")
                    )
                    (try_let (json_resp (parse_json NoteResponse resp))
                      (catch parse_err
                        (call set_status "Server error while updating note" "true")
                      )
                      (let (err_msg (map_get json_resp "error"))
                        (if (!= err_msg "")
                          (call set_status err_msg "true")
                          (do
                            (call cancel_edit)
                            (call set_status "Note updated successfully!" "false")
                            (call load_notes)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun delete_note (id)
    (do
      (call set_status "Deleting note..." "false")
      (let (req_body (encode_json (dict ("id" id))))
        (try_let (resp (fetch "/api/notes" "DELETE" req_body))
          (catch err
            (call set_status "Failed to delete note" "true")
          )
          (try_let (json_resp (parse_json NoteResponse resp))
            (catch parse_err
              (call set_status "Server error while deleting note" "true")
            )
            (let (err_msg (map_get json_resp "error"))
              (if (!= err_msg "")
                (call set_status err_msg "true")
                (do
                  (call set_status "Note deleted successfully!" "false")
                  (call load_notes)
                )
              )
            )
          )
        )
      )
    )
  )

  (on_event (dom_query "#create-btn") "click" (lambda (e)
    (call create_note)
  ))

  (on_event (dom_query "#search-input") "input" (lambda (e)
    (call load_notes)
  ))

  (on_event (dom_query "#refresh-btn") "click" (lambda (e)
    (call load_notes)
  ))

  (on_event (dom_query "#save-edit-btn") "click" (lambda (e)
    (call save_edit)
  ))

  (on_event (dom_query "#cancel-edit-btn") "click" (lambda (e)
    (call cancel_edit)
  ))

  (on_event (dom_query "#edit-modal") "keydown" (lambda (e)
    (let (content_input (dom_query "#edit-note-content"))
      (let (save_button (dom_query "#save-edit-btn"))
        (do
          (if (= e.key "Escape")
            (do (call cancel_edit) (call e.preventDefault) (set e.returnValue false))
            (set e.returnValue true)
          )
          (if (= e.key "Tab")
            (do
              (if e.shiftKey
                (if (= e.target content_input)
                  (do (call save_button.focus) (call e.preventDefault) (set e.returnValue false))
                  (set e.returnValue true)
                )
                (if (= e.target save_button)
                  (do (call content_input.focus) (call e.preventDefault) (set e.returnValue false))
                  (set e.returnValue true)
                )
              )
            )
            (set e.returnValue true)
          )
        )
      )
    )
  ))

  (call load_notes)
)
